# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_active_channel_id_here

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Bot Behavior Settings (Optional - defaults shown)
COOLDOWN=600
USER_COOLDOWN=60
BASE_CHANCE=0.001
SCALE_FACTOR=0.0005
CLEANUP_INTERVAL=3600

# Testing Mode (Optional)
TESTING_MODE=false
TEST_CHANNEL_ID=your_test_channel_id_here
TEST_COOLDOWN=30
TEST_USER_COOLDOWN=10
TEST_BASE_CHANCE=0.1
TEST_SCALE_FACTOR=0.05